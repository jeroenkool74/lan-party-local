# Copy to .env and adjust. Every value has a default; an empty .env works.

# ---------------------------------------------------------------- network / ports
# Bind to one interface (e.g. the LAN IP 192.168.1.10) instead of all of them.
OPENRCT2_BIND=0.0.0.0
OPENRCT2_PORT=11753
DASHBOARD_BIND=0.0.0.0
DASHBOARD_PORT=8080
TZ=Europe/Amsterdam

# ---------------------------------------------------------------- game server
# Pinned OpenRCT2 version; clients must run the same version. See README "Updating OpenRCT2".
OPENRCT2_VERSION=0.5.7
SERVER_NAME=LAN Tycoon
SERVER_DESCRIPTION=Free-for-all - build your own rides, earn your own money
SERVER_GREETING=Welcome! Say !help in chat. Rides you build are yours.
# Optional join password (admins have passwordless login).
SERVER_PASSWORD=
MAX_PLAYERS=16
# File name inside ./park to start a NEW game from (only used while no saves exist).
INITIAL_PARK=
# Pause the simulation when nobody is connected.
PAUSE_WHEN_EMPTY=true
# Only allow keys registered in users.json (lock the server after everyone joined once).
KNOWN_KEYS_ONLY=false

# ---------------------------------------------------------------- saves
# OpenRCT2 autosave: 0=1 min, 1=5 min, 2=15 min, 3=30 min, 4=1 hour
AUTOSAVE_FREQUENCY=1
# Number of autosave files OpenRCT2 keeps (24 x 5 min = 2 hours)
AUTOSAVE_AMOUNT=24
# Extra archive copy of the newest autosave every N minutes (0 = off), keep M of them
ARCHIVE_INTERVAL_MINUTES=60
ARCHIVE_KEEP=48
# While exactly one player is online, also save every N seconds (0 = off).
# Limits what can be lost when the last player leaves and the server is stopped soon after.
SAFETY_SAVE_SECONDS=60

# ---------------------------------------------------------------- plugins
# Comma separated. Available: ffa-ownership, ffa-individual-economy, ffa-anti-grief,
# ffa-rate-limit, ffa-disable-track-designs, ffa-cheat-toggle, ffa-ip-ban, lan-stats
ENABLED_PLUGINS=ffa-ownership,ffa-individual-economy,ffa-anti-grief,ffa-rate-limit,ffa-disable-track-designs,ffa-cheat-toggle,lan-stats

# Low-maintenance gameplay (ffa-cheat-toggle; applied when the park loads)
CHEAT_DISABLE_BREAKDOWNS=true
CHEAT_DISABLE_VANDALISM=true
CHEAT_DISABLE_RIDE_VALUE_AGING=true
CHEAT_DISABLE_PLANT_AGING=true
CHEAT_DISABLE_LITTERING=true
CHEAT_MOW_GRASS=true
CHEAT_UNLOCK_ALL_RIDES=true

# ---------------------------------------------------------------- dashboard
DASHBOARD_TITLE=LAN Tycoon
# OpenRCT2 stores money in tenths; the dashboard shows it like the game does with this symbol.
CURRENCY_SYMBOL=€
# How often the plugin sends statistics (ms) and how often history is sampled (s).
STATS_INTERVAL_MS=10000
HISTORY_SAMPLE_SECONDS=60

# ---------------------------------------------------------------- resources
OPENRCT2_CPUS=2
OPENRCT2_MEMORY=3g
