{
  "name": "lan-openrct2-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Live statistics dashboard for the LAN OpenRCT2 server",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/main.ts",
    "dev:web": "vite web",
    "build": "vite build web",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
